# Rogalik — что не попадает в Git (решение D13)
#
# Исключаются только временные кэши, производные сборки, секреты и диагностические
# журналы. Исходники и игровые файлы (docs/, game/, assets/, plugins/, tools/,
# reports/*.png) отслеживаются полностью.

# --- Godot: импорт-кэш, локальные временные файлы ---
game/**/.godot/
*.import*.tmp
*.translation

# --- Сторонние клоны и установленные пакеты ---
# Клон Godot MCP (node_modules) не публикуется: tools/setup-godot-mcp.ps1 восстанавливает его.
tools/godot-mcp/
node_modules/
.pnpm-store/

# --- Python ---
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/

# --- Локальные сборки, профили инструментов, кэши ---
build/
dist/
.cache/
.pixelorama-user/

# --- Секреты и локальные настройки (не публиковать никогда) ---
.env
.env.*
!.env.example
*.pem
*.key
id_rsa
id_rsa.*
credentials.json

# --- Логи и диагностика вне доказательств ---
*.log
reports/*.log

# --- ОС и редакторы ---
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/

# --- Временные файлы правки ---
*.orig
*.rej
*~
